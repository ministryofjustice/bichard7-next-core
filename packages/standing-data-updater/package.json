  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0",
    "jsonlint-mod": "^1.7.6",
    "lint-staged": "^17.6.0",
    "mockdate": "^3.0.5",
    "ts-jest": "^29.4.15"
