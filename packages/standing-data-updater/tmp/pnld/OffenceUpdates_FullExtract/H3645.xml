<?xml version="1.0" encoding="utf-8"?><documents xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation = "HDocumentSchema.xsd"><document type = "H"><pnldref>H3645</pnldref><english><title>Forged / counterfeited goods to evade prohibition on import / export</title><additionalkeywords><additionalkeyword>forgery</additionalkeyword><additionalkeyword>counterfeit</additionalkeyword><additionalkeyword>fraudulently</additionalkeyword><additionalkeyword>export</additionalkeyword><additionalkeyword>import</additionalkeyword><additionalkeyword>forge</additionalkeyword><additionalkeyword>carry</additionalkeyword><additionalkeyword>carried</additionalkeyword><additionalkeyword>remove</additionalkeyword><additionalkeyword>removing</additionalkeyword><additionalkeyword>deposit</additionalkeyword><additionalkeyword>harbour</additionalkeyword><additionalkeyword>harboured</additionalkeyword><additionalkeyword>harbouring</additionalkeyword><additionalkeyword>keep</additionalkeyword><additionalkeyword>kept</additionalkeyword><additionalkeyword>conceal</additionalkeyword><additionalkeyword>deal with</additionalkeyword><additionalkeyword>dealt</additionalkeyword><additionalkeyword>dealing</additionalkeyword><additionalkeyword>restrict</additionalkeyword><additionalkeyword>restricting</additionalkeyword><additionalkeyword>prohibit</additionalkeyword><additionalkeyword>prohibited</additionalkeyword><additionalkeyword>prohibiting</additionalkeyword><additionalkeyword>with intent</additionalkeyword><additionalkeyword>customs</additionalkeyword><additionalkeyword>excise</additionalkeyword><additionalkeyword>management</additionalkeyword></additionalkeywords><standardoffencewording>On **(..SPECIFY DATE..) at **(..SPECIFY TOWNSHIP..) was knowingly concerned in&lt;br /&gt;&lt;br /&gt; (A)_[carrying]_&lt;br /&gt; (B)_[removing]_&lt;br /&gt; (C)_[depositing]_&lt;br /&gt; (D)_[harbouring]_&lt;br /&gt; (E)_[keeping]_&lt;br /&gt; (F)_[concealing]_&lt;br /&gt; (G)_[dea